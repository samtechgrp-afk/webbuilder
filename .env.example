# ─────────────────────────────────────────────────────────────────────────────
# Website builder configuration. Copy to .env and fill in.
# `npm run env:check` validates this file; the server refuses to start (and
# prints what's wrong) when a required value is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Postgres connection string (Neon, Supabase, RDS or your own; see the README).
DATABASE_URL="postgresql://builder:builder@localhost:5432/builder?schema=public"
# Signs login sessions. 32+ characters: openssl rand -base64 32
SESSION_SECRET="dev-only-change-me-dev-only-change-me-0123456789"
# Host that serves the platform itself (admin, editor, sign-up). Every other
# host is a client site: <subdomain>.ROOT_DOMAIN or a custom domain.
# NEXT_PUBLIC_PLATFORM_DOMAIN is accepted as an alias.
ROOT_DOMAIN="localhost:3000"

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Order receipts, store-owner alerts and site welcome emails. Without a key,
# emails are written to the server log (and the EmailLog table) instead.
# RESEND_API_KEY="re_..."
# Sender; the domain must be verified in Resend. Default: Website Builder <noreply@ROOT_DOMAIN>
# EMAIL_FROM="Harbor Studio <hello@harbor.studio>"

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# Each shop connects its own Stripe keys in the admin (encrypted at rest).
# This platform-level key is optional and reserved for platform billing.
# STRIPE_SECRET_KEY="sk_live_..."
# Key for encrypting shop payment secrets at rest (else derived from SESSION_SECRET).
# SECRETS_KEY="openssl rand -base64 32"

# ── Uploads ──────────────────────────────────────────────────────────────────
# local (default): files go to public/uploads on this server's disk.
# s3: any S3-compatible bucket (AWS S3, Cloudflare R2, SeaweedFS, Garage, MinIO).
# STORAGE_DRIVER="s3"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="uploads"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# Optional public URL of the bucket or a CDN in front of it. Without it the
# app streams files from the bucket itself at /uploads/...
# S3_PUBLIC_URL="https://media.example.com"

# ── Scheduling and access ────────────────────────────────────────────────────
# Bearer token for /api/cron/scheduled (vercel.json calls it every minute).
# Required in production for scheduled posts to go live. 16+ characters.
# CRON_SECRET="openssl rand -hex 24"
# open (default): anyone can create an account at /signup. closed: invite only.
# SIGNUPS="open"

# ── Docker only (docker-compose.yml / scripts/docker-init.mjs) ───────────────
# First platform admin, created on an empty database.
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="at-least-10-characters"
# Load the demo sites and accounts instead (never in production).
# SEED_DEMO="false"

# ── Testing and advanced ─────────────────────────────────────────────────────
# Point the Stripe and Resend clients at local mocks (the e2e suites do).
# STRIPE_API_BASE="http://127.0.0.1:4242"
# RESEND_API_BASE="http://127.0.0.1:4243"
# Origin the server uses to call itself (exports, 404 pages). Default: http://127.0.0.1:PORT
# INTERNAL_URL="http://127.0.0.1:3000"
# Skip validation (image builds only; the server validates again at boot).
# SKIP_ENV_VALIDATION="1"

{
  "key": "hr-recruitment",
  "name": "HR & Recruitment Consulting",
  "sector": "agency",
  "description": "Friendly teal recruitment firm with a live job board, employer services, placement stats and candidate testimonials.",
  "highlights": [
    "Job board post type",
    "Employer pricing",
    "Placement stats",
    "Candidate testimonials"
  ],
  "site": {
    "name": "Brightpath Talent",
    "tagline": "Hiring partners for fast-growing teams",
    "logoText": "Brightpath Talent",
    "seo": {
      "titleTemplate": "%s · {{site}}",
      "description": "Brightpath Talent recruits engineers, designers and operators for fast-growing companies, and helps candidates find the right next role."
    }
  },
  "tokens": {
    "colors": {
      "background": "#FFFFFF",
      "surface-low": "#F2FAF8",
      "surface-mid": "#E3F4F0",
      "surface-high": "#FFFFFF",
      "primary": "#0F766E",
      "on-primary": "#FFFFFF",
      "accent": "#F97316",
      "heading": "#0B2925",
      "text": "#33504B",
      "muted": "#6D8783",
      "border": "#DCEDE9"
    },
    "fonts": {
      "heading": "var(--font-inter), system-ui, sans-serif",
      "display": "var(--font-inter), system-ui, sans-serif",
      "body": "var(--font-inter), system-ui, sans-serif",
      "mono": "var(--font-geist-mono), ui-monospace, monospace"
    },
    "typeScale": {
      "minBase": 1,
      "maxBase": 1.0625,
      "minRatio": 1.2,
      "maxRatio": 1.27,
      "minWidth": 360,
      "maxWidth": 1280
    },
    "lineHeights": {
      "tight": "1.08",
      "snug": "1.3",
      "body": "1.65"
    },
    "letterSpacing": {
      "tight": "-0.03em",
      "snug": "-0.01em",
      "wide": "0.1em"
    },
    "spaceUnit": 8,
    "radii": {
      "sm": "8px",
      "md": "12px",
      "lg": "20px",
      "pill": "999px",
      "button": "999px",
      "card": "16px"
    },
    "shadows": {
      "sm": "0 1px 2px rgba(15, 23, 42, 0.06)",
      "md": "0 1px 3px rgba(15, 23, 42, 0.06), 0 12px 32px -14px rgba(15, 23, 42, 0.2)",
      "lg": "0 2px 6px rgba(15, 23, 42, 0.05), 0 32px 64px -24px rgba(15, 23, 42, 0.3)"
    }
  },
  "look": {
    "headings": "normal",
    "density": "regular",
    "cards": "bordered",
    "headerBorder": false
  },
  "header": {
    "logo": "{{site}}",
    "nav": [
      {
        "label": "Jobs",
        "href": "/jobs"
      },
      {
        "label": "For employers",
        "href": "/employers"
      }
    ],
    "action": {
      "label": "Post a role",
      "href": "/employers"
    }
  },
  "footer": {
    "text": "Recruiting for fast-growing teams across North America and Europe.",
    "columns": [
      {
        "title": "Candidates",
        "links": [
          {
            "label": "Open jobs",
            "href": "/jobs"
          },
          {
            "label": "Send your CV",
            "href": "mailto:talent@example.com"
          }
        ]
      },
      {
        "title": "Employers",
        "links": [
          {
            "label": "Services",
            "href": "/employers"
          },
          {
            "label": "Contact",
            "href": "mailto:hire@example.com"
          }
        ]
      }
    ],
    "legal": "© 2026 {{site}} Inc."
  },
  "images": [
    {
      "key": "hero",
      "alt": "Candidate and recruiter in conversation",
      "motif": "portrait",
      "width": 1000,
      "height": 1250,
      "palette": [
        "#E3F4F0",
        "#F2FAF8",
        "#0F766E",
        "#F97316"
      ]
    },
    {
      "key": "office",
      "alt": "Bright open-plan office",
      "motif": "arch",
      "width": 1200,
      "height": 960,
      "palette": [
        "#F2FAF8",
        "#E3F4F0",
        "#0F766E",
        "#F97316"
      ]
    }
  ],
  "postTypes": [
    {
      "key": "job",
      "singular": "Job",
      "plural": "Jobs",
      "prefix": "roles",
      "icon": "◉",
      "description": "Open roles.",
      "fields": [
        {
          "key": "location",
          "label": "Location",
          "type": "TEXT",
          "required": true
        },
        {
          "key": "employment",
          "label": "Type",
          "type": "SELECT",
          "options": [
            "Full-time",
            "Contract",
            "Part-time"
          ]
        },
        {
          "key": "salary",
          "label": "Salary range",
          "type": "TEXT"
        }
      ]
    }
  ],
  "entries": [

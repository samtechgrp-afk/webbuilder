{
  "key": "real-estate",
  "name": "Real Estate Agency",
  "sector": "hospitality",
  "description": "Polished property agency site with featured listings (price, beds, baths), neighbourhood guides, agent stats and valuation CTA.",
  "highlights": [
    "Listings with prices",
    "Agent stats",
    "Valuation CTA",
    "Neighbourhood features"
  ],
  "site": {
    "name": "Northgate Realty",
    "tagline": "Homes in Seattle's best neighbourhoods",
    "logoText": "Northgate Realty",
    "seo": {
      "titleTemplate": "%s · {{site}}",
      "description": "Northgate Realty helps buyers and sellers across Seattle with local agents, honest advice and great photography."
    }
  },
  "tokens": {
    "colors": {
      "background": "#FFFFFF",
      "surface-low": "#F5F6F4",
      "surface-mid": "#E9ECE7",
      "surface-high": "#FFFFFF",
      "primary": "#1E3A34",
      "on-primary": "#FFFFFF",
      "accent": "#C2A15C",
      "heading": "#13211D",
      "text": "#3B4743",
      "muted": "#727D79",
      "border": "#E1E5E0"
    },
    "fonts": {
      "heading": "var(--font-fraunces), Georgia, serif",
      "display": "var(--font-fraunces), Georgia, serif",
      "body": "var(--font-inter), system-ui, sans-serif",
      "mono": "var(--font-geist-mono), ui-monospace, monospace"
    },
    "typeScale": {
      "minBase": 1,
      "maxBase": 1.0625,
      "minRatio": 1.2,
      "maxRatio": 1.3,
      "minWidth": 360,
      "maxWidth": 1280
    },
    "lineHeights": {
      "tight": "1.08",
      "snug": "1.3",
      "body": "1.65"
    },
    "letterSpacing": {
      "tight": "-0.02em",
      "snug": "-0.005em",
      "wide": "0.14em"
    },
    "spaceUnit": 8,
    "radii": {
      "sm": "4px",
      "md": "8px",
      "lg": "14px",
      "pill": "999px",
      "button": "999px",
      "card": "10px"
    },
    "shadows": {
      "sm": "0 1px 2px rgba(15, 23, 42, 0.06)",
      "md": "0 1px 3px rgba(15, 23, 42, 0.06), 0 12px 32px -14px rgba(15, 23, 42, 0.2)",

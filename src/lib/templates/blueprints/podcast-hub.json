    "lineHeights": {
      "tight": "0.98",
      "snug": "1.25",
      "body": "1.65"
    },
    "letterSpacing": {
      "tight": "-0.04em",
      "snug": "-0.015em",
      "wide": "0.12em"
    },
    "spaceUnit": 8,
    "radii": {
      "sm": "10px",
      "md": "16px",
      "lg": "28px",
      "pill": "999px",
      "button": "999px",
      "card": "24px"
    },
    "shadows": {
      "sm": "0 1px 2px rgba(15, 23, 42, 0.06)",
      "md": "0 1px 3px rgba(15, 23, 42, 0.06), 0 12px 32px -14px rgba(15, 23, 42, 0.2)",

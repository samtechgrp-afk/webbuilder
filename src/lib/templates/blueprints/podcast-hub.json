{
  "key": "podcast-hub",
  "name": "Podcast & Media Hub",
  "sector": "portfolio",
  "description": "Bold, warm podcast site with an episode archive, host bios, listen-on links, sponsor info and a newsletter call to action.",
  "highlights": [
    "Episode post type",
    "Hosts",
    "Listen-on links",
    "Sponsorship pricing"
  ],
  "site": {
    "name": "Off the Record",
    "tagline": "Candid conversations with people who build things",
    "logoText": "Off the Record",
    "seo": {
      "titleTemplate": "%s · {{site}}",
      "description": "Off the Record is a weekly interview podcast with founders, artists and scientists about the messy middle of making things."
    }
  },
  "tokens": {
    "colors": {
      "background": "#FFF8EF",
      "surface-low": "#FCEEDC",
      "surface-mid": "#F8E1C4",
      "surface-high": "#FFFFFF",
      "primary": "#E8452C",
      "on-primary": "#FFFFFF",
      "accent": "#1F3A5F",
      "heading": "#1E1410",
      "text": "#4A3A32",
      "muted": "#8A776C",
      "border": "rgba(30, 20, 16, 0.12)"
    },
    "fonts": {
      "heading": "var(--font-geist-sans), system-ui, sans-serif",
      "display": "var(--font-geist-sans), system-ui, sans-serif",
      "body": "var(--font-inter), system-ui, sans-serif",
      "mono": "var(--font-geist-mono), ui-monospace, monospace"
    },
    "typeScale": {
      "minBase": 1,
      "maxBase": 1.0625,
      "minRatio": 1.24,
      "maxRatio": 1.34,
      "minWidth": 360,
      "maxWidth": 1280

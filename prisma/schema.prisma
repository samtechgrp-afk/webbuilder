// Multi-tenant CMS + visual builder schema.
//
// Tenancy rule: every row that belongs to a client website carries `siteId`.
// Application code never queries these models through the raw client; it goes
// through `tenantDb(siteId)` (src/lib/tenant-db.ts), which injects the siteId
// filter into every read and write. Composite uniques are always scoped by
// siteId so two tenants can use the same slugs, keys and folder names.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & access
// ─────────────────────────────────────────────────────────────────────────────

/// A person. Identity is global (one login across many sites); what they may
/// do is decided per site by their Membership's Role.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  passwordHash    String
  /// Platform staff (Super Admin). Bypasses site RBAC; every action is audited.
  isPlatformAdmin Boolean   @default(false)
  avatarUrl       String?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships Membership[]
  sessions    Session[]
  posts       Post[]         @relation("PostAuthor")
  revisions   PostRevision[]
  designTokenRevisions DesignTokenRevision[]
  exports     SiteExport[]
  apiKeys     ApiKey[]
  editLocks   EditLock[]
  uploads     MediaAsset[]
  auditLogs   AuditLog[]
}

/// Server-side session. The browser only holds a signed cookie with this id,
/// so sessions can be revoked instantly (logout everywhere, role removal).
model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A named bundle of permission keys (see src/lib/rbac.ts).
/// System roles have siteId = null and are shared by all sites; a designer can
/// clone one into a site-specific role (siteId set) and tune its permissions.
model Role {
  id          String   @id @default(cuid())
  siteId      String?
  key         String // "designer" | "client_admin" | "editor" | "author" | custom
  name        String
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site        Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([siteId, key])
}

/// Joins a User to a Site with exactly one Role. This is the tenant boundary
/// for people: no Membership (and not platform admin) means no access.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  siteId    String
  roleId    String
  invitedBy String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, siteId])
  @@index([siteId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant
// ─────────────────────────────────────────────────────────────────────────────

enum SiteStatus {
  DRAFT
  LIVE
  SUSPENDED
}

/// One client website (the tenant).
model Site {
  id           String     @id @default(cuid())
  name         String
  /// acme → acme.<ROOT_DOMAIN> and /sites/acme
  subdomain    String     @unique
  customDomain String?    @unique
  status       SiteStatus @default(DRAFT)
  /// Branding for the client portal (logo, accent colour).
  branding     Json       @default("{}")
  /// Global design tokens: colours, fluid type scale, radii, shadows,
  /// breakpoints. Only roles with `design.tokens` may change these.
  designTokens Json       @default("{}")
  /// Bumped on every token save; saves carry the version they started from
  /// so two designers can't silently overwrite each other.
  designTokensVersion Int @default(0)
  /// Site-wide SEO defaults, analytics ids, locale.
  settings     Json       @default("{}")
  /// Designer-only custom <head> code / CSS. Never editable in Client Mode.
  customCode   Json       @default("{}")
  /// Headless GraphQL API (/api/v1/sites/<site>/graphql). Off until a
  /// designer turns it on under Developer.
  graphqlEnabled Boolean  @default(false)
  /// When on, requests without a key can read published content.
  graphqlPublic  Boolean  @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles        Role[]
  memberships  Membership[]
  postTypes    PostType[]
  posts        Post[]
  revisions    PostRevision[]
  fieldGroups  FieldGroup[]
  customFields CustomField[]
  fieldValues  FieldValue[]
  taxonomies   Taxonomy[]
  terms        Term[]
  mediaFolders MediaFolder[]
  mediaAssets  MediaAsset[]
  designTokenRevisions DesignTokenRevision[]
  exports      SiteExport[]
  apiKeys      ApiKey[]
  editLocks    EditLock[]
  auditLogs    AuditLog[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Content (WordPress-style)
// ─────────────────────────────────────────────────────────────────────────────

/// Custom Post Type definition: page, post, portfolio, product, testimonial…
model PostType {
  id               String   @id @default(cuid())
  siteId           String
  key              String // "page", "post", "product"
  labelSingular    String
  labelPlural      String
  icon             String?
  hierarchical     Boolean  @default(false)
  /// Whether entries use the visual builder canvas or a plain rich-text body.
  usesBuilder      Boolean  @default(false)
  hasArchive       Boolean  @default(false)
  /// URL prefix for public routes, e.g. "blog" → /blog/my-post
  routePrefix      String?
  description      String?
  /// How new entries get their slug.
  slugRule         SlugRule @default(TITLE)
  /// Published entries are readable at /api/v1/sites/<site>/<key>.
  apiEnabled       Boolean  @default(false)
  /// Builder document (a Post of the system "template" type) that renders
  /// every entry of this type on the live site. Null → default layout.
  singleTemplateId String?  @unique
  /// Page templates entries may pick ({ templates: [{ key, label }] }).
  metadata         Json     @default("{}")
  isSystem         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  site           Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  posts          Post[]
  taxonomies     Taxonomy[] @relation("TaxonomyPostTypes")
  singleTemplate Post?      @relation("SingleTemplate", fields: [singleTemplateId], references: [id], onDelete: SetNull)

  @@unique([siteId, key])
}

enum SlugRule {
  /// "Oak dining table" → oak-dining-table
  TITLE
  /// 2026-10-25-oak-dining-table
  DATE_TITLE
  /// Short random id, for entries whose titles repeat (team members, FAQs).
  ID
}

/// Live visibility is `publishedRevisionId != null` and status != TRASHED.
/// SCHEDULED entries may still show an older published revision until
/// `scheduledAt`, when `scheduledRevisionId` is promoted.
enum PostStatus {
  DRAFT
  PENDING_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
  TRASHED
}

/// Any content entry: page, blog post, product, etc.
model Post {
  id                  String     @id @default(cuid())
  siteId              String
  postTypeId          String
  authorId            String?
  parentId            String?
  title               String
  slug                String
  status              PostStatus @default(DRAFT)
  excerpt             String?
  /// Working copy. For builder posts this is a BuilderDocument (node tree);
  /// for plain posts it is rich-text JSON. Live visitors never read this.
  draft               Json       @default("{}")
  /// The revision visitors see. Publishing = pointing this at a revision.
  publishedRevisionId String?    @unique
  publishedAt         DateTime?
  scheduledAt         DateTime?
  /// The revision that goes live at `scheduledAt`.
  scheduledRevisionId String?    @unique
  trashedAt           DateTime?
  menuOrder           Int        @default(0)
  featuredImageId     String?
  /// Page template key (from PostType.metadata.templates). Field group
  /// location rules can target it.
  template            String?

  // SEO (client-editable)
  seoTitle       String?
  seoDescription String?
  ogImageId      String?
  noIndex        Boolean @default(false)
  canonicalUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site              Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  postType          PostType       @relation(fields: [postTypeId], references: [id])
  author            User?          @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  parent            Post?          @relation("PostTree", fields: [parentId], references: [id])
  children          Post[]         @relation("PostTree")
  revisions         PostRevision[] @relation("PostRevisions")
  publishedRevision PostRevision?  @relation("PublishedRevision", fields: [publishedRevisionId], references: [id])
  scheduledRevision PostRevision?  @relation("ScheduledRevision", fields: [scheduledRevisionId], references: [id], onDelete: SetNull)
  ogImage           MediaAsset?    @relation("OgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  featuredImage     MediaAsset?    @relation("FeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  fieldValues       FieldValue[]
  terms             PostTerm[]
  editLock          EditLock?
  templateFor       PostType?      @relation("SingleTemplate")

  @@unique([siteId, postTypeId, slug])
  @@index([siteId, status])
  @@index([siteId, postTypeId, status])
  @@index([status, scheduledAt])
}

enum RevisionKind {
  AUTOSAVE
  DRAFT
  SUBMITTED
  PUBLISHED
  RESTORED
  SCHEDULED
}

/// Immutable snapshot of a post. Every save, publish and rollback appends one,
/// so any change can be undone at any time.
model PostRevision {
  id        String       @id @default(cuid())
  siteId    String
  postId    String
  version   Int
  kind      RevisionKind
  title     String
  document  Json
  /// Everything outside the document at the time of the snapshot: custom
  /// field values by key, terms, featured image, excerpt, SEO. The live site
  /// reads published entries from here, never from the working copy.
  meta      Json         @default("{}")
  message   String?
  authorId  String?
  createdAt DateTime     @default(now())

  site          Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  post          Post  @relation("PostRevisions", fields: [postId], references: [id], onDelete: Cascade)
  author        User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedPost Post? @relation("PublishedRevision")
  scheduledPost Post? @relation("ScheduledRevision")

  @@unique([postId, version])
  @@index([siteId, postId, createdAt])
}

/// Pessimistic edit lock so a client and a designer don't overwrite each
/// other. Held while the editor is open, refreshed by heartbeat, expires.
model EditLock {
  id        String   @id @default(cuid())
  siteId    String
  postId    String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Custom fields (ACF-style)
// ─────────────────────────────────────────────────────────────────────────────

/// A set of fields shown on entries that match its location rules.
model FieldGroup {
  id          String   @id @default(cuid())
  siteId      String
  key         String
  label       String
  description String?
  /// OR-of-AND rules (src/lib/cms/location.ts), e.g.
  /// [[{ param: "post_type", op: "==", value: "<postTypeId>" },
  ///   { param: "post_term", op: "==", value: "<termId>" }]]
  location    Json     @default("[]")
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  site   Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  fields CustomField[]

  @@unique([siteId, key])
}

enum FieldType {
  TEXT
  TEXTAREA
  RICH_TEXT
  NUMBER
  PRICE
  /// Toggle switch
  BOOLEAN
  DATE
  URL
  EMAIL
  VIDEO_URL
  IMAGE
  GALLERY
  FILE
  SELECT
  RADIO
  CHECKBOX
  /// Post object
  RELATION
  USER
  TAXONOMY
  REPEATER
  FLEXIBLE
  COLOR
}

/// Field definition. Designers own definitions (`schema.manage`); clients
/// only edit values, and only where `clientEditable` is true.
model CustomField {
  id             String    @id @default(cuid())
  siteId         String
  groupId        String
  key            String
  label          String
  type           FieldType
  instructions   String?
  required       Boolean   @default(false)
  clientEditable Boolean   @default(true)
  /// Type-specific config: choices, min/max, currency, multiple, target
  /// post types or taxonomy, repeater sub-fields, flexible content layouts.
  /// Shape per type: src/lib/cms/fields.ts.
  config         Json      @default("{}")
  defaultValue   Json?
  order          Int       @default(0)

  site   Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  group  FieldGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  values FieldValue[]

  @@unique([siteId, groupId, key])
}

model FieldValue {
  id      String @id @default(cuid())
  siteId  String
  postId  String
  fieldId String
  value   Json

  site  Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  post  Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([postId, fieldId])
  @@index([siteId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Taxonomies
// ─────────────────────────────────────────────────────────────────────────────

/// Categories (hierarchical) or tags (flat). Attached to one or more post types.
model Taxonomy {
  id           String  @id @default(cuid())
  siteId       String
  key          String // "category", "tag", "product_cat"
  label        String
  hierarchical Boolean @default(false)

  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  postTypes PostType[] @relation("TaxonomyPostTypes")
  terms     Term[]

  @@unique([siteId, key])
}

model Term {
  id         String  @id @default(cuid())
  siteId     String
  taxonomyId String
  parentId   String?
  name       String
  slug       String

  site     Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  taxonomy Taxonomy   @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)
  parent   Term?      @relation("TermTree", fields: [parentId], references: [id])
  children Term[]     @relation("TermTree")
  posts    PostTerm[]

  @@unique([siteId, taxonomyId, slug])
}

model PostTerm {
  postId String
  termId String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  term Term @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([postId, termId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Media
// ─────────────────────────────────────────────────────────────────────────────

model MediaFolder {
  id       String  @id @default(cuid())
  siteId   String
  parentId String?
  name     String

  site     Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children MediaFolder[] @relation("FolderTree")
  assets   MediaAsset[]

  @@unique([siteId, parentId, name])
}

enum AltTextSource {
  MANUAL
  GENERATED
  FILENAME
}

/// A file in the site's storage prefix (sites/<siteId>/…). Images are
/// converted to WebP on upload; responsive sizes live in `variants`.
model MediaAsset {
  id            String        @id @default(cuid())
  siteId        String
  folderId      String?
  uploadedById  String?
  /// Storage key, always prefixed with the siteId.
  storageKey    String
  url           String
  originalName  String
  mimeType      String
  sizeBytes     Int
  width         Int?
  height        Int?
  /// { "640": "/uploads/…-640.webp", "1280": "…" }
  variants      Json          @default("{}")
  /// Tiny base64 placeholder for blur-up lazy loading.
  blurDataUrl   String?
  title         String?
  altText       String?
  altTextSource AltTextSource @default(FILENAME)
  caption       String?
  description   String?
  tags          String[]
  createdAt     DateTime      @default(now())

  site       Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  folder     MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  ogFor      Post[]       @relation("OgImage")
  featuredIn Post[]       @relation("FeaturedImage")

  @@unique([siteId, storageKey])
  @@index([siteId, createdAt])
  @@index([siteId, mimeType])
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  siteId    String?
  userId    String?
  action    String // "post.publish", "post.restore", "media.upload", …
  targetId  String?
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  site Site? @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
}

/// Every saved version of a site's design tokens, so a designer can roll the
/// whole design system back. The live tokens stay on Site.designTokens, which
/// the renderer and the public cache already read.
model DesignTokenRevision {
  id        String   @id @default(cuid())
  siteId    String
  version   Int
  tokens    Json
  /// Preset applied in this save, if any.
  preset    String?
  message   String?
  authorId  String?
  createdAt DateTime @default(now())

  site   Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([siteId, version])
}

enum ExportStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// A static export of a site: every live page compiled to HTML with its CSS,
/// fonts and media, zipped. The zip lives in private storage (`fileKey`)
/// and is downloaded through an authenticated route.
model SiteExport {
  id          String       @id @default(cuid())
  siteId      String
  status      ExportStatus @default(QUEUED)
  /// Absolute URL the bundle will be hosted at; used for canonical links and the sitemap.
  baseUrl     String
  total       Int          @default(0)
  progress    Int          @default(0)
  pageCount   Int          @default(0)
  sizeBytes   Int          @default(0)
  fileKey     String?
  /// Files in the bundle with their sizes, and any pages that were skipped.
  manifest    Json         @default("{}")
  error       String?
  createdById String?
  createdAt   DateTime     @default(now())
  finishedAt  DateTime?

  site      Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Headless API
// ─────────────────────────────────────────────────────────────────────────────

enum ApiKeyScope {
  /// Published content only; safe to ship in a public frontend.
  READ
  /// Drafts and previews, plus creating and updating drafts.
  READ_WRITE
}

/// A GraphQL API key. Only a SHA-256 hash of the secret is stored; the key
/// is shown once when it's created.
model ApiKey {
  id          String      @id @default(cuid())
  siteId      String
  name        String
  scope       ApiKeyScope @default(READ)
  /// First characters of the key, so people can tell keys apart.
  prefix      String
  keyHash     String      @unique
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime    @default(now())

  site      Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
}
